{
  "name": "gm-pantry",
  "version": "0.0.0",
  "description": "Game repositories: static directories of game archives with a repo.json, plus a parser, validator and CLI.",
  "keywords": ["gamemaker", "repository", "archive", "static"],
  "homepage": "https://github.com/QuentinJanuel/GM-Pantry#readme",
  "bugs": "https://github.com/QuentinJanuel/GM-Pantry/issues",
  "repository": { "type": "git", "url": "git+https://github.com/QuentinJanuel/GM-Pantry.git" },
  "license": "MIT",
  "type": "module",
  "files": ["dist", "LICENSE"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "bin": { "gm-pantry": "dist/cli.js" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts scripts/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0" },
  "engines": { "node": ">=24" }
}
